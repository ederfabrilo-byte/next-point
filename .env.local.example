# Copie este arquivo para .env.local e preencha com as chaves reais
# do Supabase (Dashboard → Settings → API).
# Apenas vars EXPO_PUBLIC_* são lidas pelo app em runtime.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...sua-anon-key

# NUNCA coloque a service_role key aqui — ela só vai em Edge Functions
# (Supabase Dashboard → Edge Functions → Secrets).
